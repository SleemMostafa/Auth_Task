@page "/login"
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<div class="login-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card login-card">
                    <div class="card-body">
                        <h3 class="card-title text-center mb-4">User Login</h3>
                        
                        <EditForm Model="@loginDto" OnValidSubmit="@HandleLogin" FormName="loginForm" class="login-form">
                            <DataAnnotationsValidator />
                            
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @errorMessage
                                </div>
                            }
                            
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <InputText id="username" class="form-control" @bind-Value="loginDto.Username" placeholder="Enter username" />
                                <ValidationMessage For="@(() => loginDto.Username)" />
                            </div>
                            
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <InputText id="password" type="password" class="form-control" @bind-Value="loginDto.Password" placeholder="Enter password" />
                                <ValidationMessage For="@(() => loginDto.Password)" />
                            </div>
                            
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary login-btn" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Logging in...</span>
                                    }
                                    else
                                    {
                                        <span>Login</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                    <div class="login-footer text-center">
                        <small class="text-muted">Default credentials: admin / admin123</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
